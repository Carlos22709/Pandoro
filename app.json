{
  "expo": {
    "name": "Pandask",
    "slug": "pandoro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pandoro",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pandask.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4adbad44-e34e-4178-a7c6-251ff2b4096a"
      }
    },
    "owner": "carlos22709s-team"
  }
}
