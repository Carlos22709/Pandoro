{
  "expo": {
    "name": "Pandoro",
    "slug": "pandoro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pandoro",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Pandask usa el micrófono para que le dictes tus pendientes a Pandoro. No guardamos el audio.",
          "speechRecognitionPermission": "Pandask convierte tu voz en texto para organizar tus pendientes. No guardamos el audio.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "bundler": "metro"
    }
  }
}
