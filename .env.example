# Copia este archivo como .env y pega tu clave. Reinicia con `npx expo start --clear` tras cambiarla.
# ADVERTENCIA: todo lo que lleva EXPO_PUBLIC_ queda incluido en el paquete de la app y
# puede extraerse. Es provisional para el MVP sin backend; no es seguro para producción.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase Authentication (Firebase Console > Configuracion del proyecto > Tus apps > Web).
# La configuracion web no es una contrasena; nunca pongas aqui cuentas de servicio.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
