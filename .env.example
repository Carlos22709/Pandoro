# Copia este archivo como .env. Reinicia con `npx expo start --clear` tras cambiarlo.
# Todo lo que lleva EXPO_PUBLIC_ queda incluido en el paquete de la app y puede extraerse:
# aquí solo va configuración pública. La clave de Gemini vive en Firebase AI Logic, no en la app.
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase (Firebase Console > Configuracion del proyecto > Tus apps > Web).
# La configuracion web no es una contrasena; nunca pongas aqui cuentas de servicio.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
