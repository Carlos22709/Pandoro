rules_version = '2';

// Pandask: cada persona solo puede leer y escribir sus propios datos,
// guardados bajo users/{uid} (tasks, plans, progress, usage/{AAAA-MM}).
// Todo lo demás queda denegado por defecto.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Denegación explícita por defecto (Firestore ya niega lo que no coincide).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
