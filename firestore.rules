rules_version = '2';

// Reglas de Cloud Firestore de Pandask (ver docs/arquitectura.md, sección 7 y docs/seguridad.md).
// Este archivo es la fuente de verdad: se copia en Firebase Console > Firestore > Reglas > Publicar.
// Cada persona solo puede leer y escribir sus propios datos, guardados bajo users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Denegación explícita por defecto (Firestore ya niega lo que no coincide).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
